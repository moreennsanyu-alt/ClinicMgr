<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>WixSharp</RootNamespace>
    <LangVersion>13.0</LangVersion>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="*.msi" />
    <None Remove="*.exe" />
    <None Remove="*.wxs" />
    <None Remove="*.wixpdb" />
    <None Remove="*.wixobj" />
  </ItemGroup>
  <ItemGroup>
    <Constant Include="BuildInfo.InstallerDir" Value="$(InstallersPath)" />
    <Constant Include="BuildInfo.DesktopPublishDir" Value="$(DesktopPublishDir)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixSharp_wix4" />
    <PackageReference Include="ThisAssembly.Constants" />
    <PackageReference Include="Nerdbank.GitVersioning" />
    <PackageReference Include="PolySharp" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="cd .&#xD;&#xA;set ide=true&#xD;&#xA;&quot;$(TargetPath)&quot;" />
  </Target>
  <Target Name="PublishBeforeBuild" BeforeTargets="CoreCompile">
     <MSBuild Projects="..\Desktop\ClinicManager.Win\ClinicManager.Win.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(DesktopPublishDir)" />
  </Target>

  
</Project>
