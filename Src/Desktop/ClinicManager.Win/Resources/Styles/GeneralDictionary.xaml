<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- General brushes, colors, and typography -->
    <Color x:Key="PrimaryColor">#1976D2</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5" />

    <Style TargetType="TextBlock" x:Key="HeadingText">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="Black" />
    </Style>
</ResourceDictionary>
